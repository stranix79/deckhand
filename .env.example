# Deckhand hub — copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me
DECKHAND_SECRET=change-me-openssl-rand-hex-32
DECKHAND_BASE_URL=https://deckhand.example.com
DECKHAND_DECK_ORIGIN=https://decks.deckhand.example.com
# Mail (magic links)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Deckhand <no-reply@example.com>"
# Plans
DECKHAND_FREE_MAX_DECKS=1
DECKHAND_FREE_MAX_VIEWERS=10
DECKHAND_FREE_LINK_DAYS=7
# Billing: odoo | stripe | empty
DECKHAND_BILLING=
# Odoo Subscriptions (DECKHAND_BILLING=odoo)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=
ODOO_PRODUCT_URL=
# Stripe (DECKHAND_BILLING=stripe)
DECKHAND_STRIPE_SECRET_KEY=
DECKHAND_STRIPE_WEBHOOK_SECRET=
DECKHAND_STRIPE_PRICE_ID=
